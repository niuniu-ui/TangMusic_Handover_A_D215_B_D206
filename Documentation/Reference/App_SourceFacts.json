  "user_function_facts": {
    "pages": [
      "调音",
      "曲库",
      "录音",
      "乐器"
    ],
    "tuning": "总音量、电子琴音量、静音、音区组；混响/延迟/合唱开关和各3参数；读取当前值、基于revision应用。没有当前B琴音色选择或笛/鼓独立音量的手机入口。",
    "library": "实际curated-catalog为32项；精选/Mutopia找谱/HTTPS MIDI直链/本地MIDI导入；最近50个本机缓存、打开/删除/导出MIDI。index.html的“12首”是旧静态占位，运行脚本按目录更新，不能按占位宣传数量。",
    "adapt": "按声部、片段（最长120s）、整体半音移调和速度25%..200%适配目标32键F3–C6/MIDI53–84；不删除或折叠越界音符；可导出适配JSON。",
    "guide": "上传已适配曲谱，显示真实板端确认进度/取消；音区组2时“弹对再继续”或“跟随曲谱”。这是FPGA键位引导，琴声由实体弹奏产生，不是MIDI自动播放录音。",
    "keymap": "32键唯一映射交换、默认/反向排列、手机草稿保存/载入、读取/应用并回读；应用前需松键并停止引导/录音/循环。",
    "four_track": "实际PCM四轨，先设BPM40–240/1,2,4小节/0或4拍预备；各轨录入/覆盖一轮，自动循环合奏、静音/独奏/音量、停止后撤销重做与清空；预备拍页面提示而非节拍声音。非手机麦克风录音。",
    "recorder": "板端双槽选择（板端能力决定可见）、开始/停止、耳机回放、删除；回传/暂停/继续，校验完整后手机离线试听并保存WAV。手机没有该页面内明确“分享”按钮，不能把系统文件保存自动说成独立分享功能。",
    "diagnostics": "同一个设备连接里提供PING/重新握手、参数回读及BLE真实TX/RX日志；自动协议会话运行时原生sendHex入口拒绝任意自定义发送，以避免干扰。",
