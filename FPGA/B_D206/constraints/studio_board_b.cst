// Tang Mega NEO 138K, PG484A. Direct keyboard scan; A18 pad input removed.
IO_LOC "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// Route the 50 MHz register/RAM clock on the dedicated global clock network.
// PR1014 on the unconstrained optimized build reported generic clock routing.
// Arora V SUG1018 section 2.7: use the synthesized IBUF output net name.
CLOCK_LOC "clk_d" BUFG = CLK;
IO_LOC "key_n" AB13;
IO_PORT "key_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// REV O control panel: J_IO.1=GND, .2=3V3, .13=NC (leave disconnected).
// Separate sustain board: SIG=B17 (hardware-confirmed D503), 3V3=3.3 V, GND=common ground.
// Piano LED Native AB R04: 3*A + 2*B + T = 96 LEDs, separate from spectrum/drums.
// Direct keyboard matrix: same 16-wire harness as array_key R03.
IO_LOC "rgb_led" J16;
IO_PORT "rgb_led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// Sipeed official audio_i2s constraints; NEO audio nets verified against schematic.
// PT8211 uses right-justified serial words despite the board's I2S net names.

// External PCM5102 was removed. C20 is exclusively Bluetooth UART TX below.

// External 8x32 WS2812B matrix: A18 DIN, 3.3 V signal, common GND.

// Tang Mega 138K ordinary Dock, PBGA484A. NOT Pro / Console constraints.
// Source: sipeed/TangMega-138K-example/hdmi_colorbar/eda_proj/src/hdmi.cst
// TMDS channel 0 = blue + H/V sync; channel 1 = green; channel 2 = red.
// Gowin binds the negative output automatically to the second pin of each pair.
IO_LOC "tmds_data_p[0]" J14,H14;
IO_PORT "tmds_data_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_data_p[1]" J15,H15;
IO_PORT "tmds_data_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_data_p[2]" K17,J17;
IO_PORT "tmds_data_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_clk_p" G15,G16;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "usb1_dp" M15;
IO_PORT "usb1_dp" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "usb1_dm" M16;
IO_PORT "usb1_dm" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "usb2_dp" H13;
IO_PORT "usb2_dp" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "usb2_dm" G13;
IO_PORT "usb2_dm" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
// Pin mapping from the 138K BTB connector table (schematic page 7).
// Read K14 only: it is CEC on 31002, TX/RX direction on 31005.
// Preserve the weak pull-up used for otherwise unused pins; never drive CEC high.
IO_LOC "hdmi_hpd" K13;
IO_PORT "hdmi_hpd" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "hdmi_aux" K14;
IO_PORT "hdmi_aux" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "debug_uart_tx" U15;
IO_PORT "debug_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;



// Dual ATK-IMU901 sticks and NEO S1: user-confirmed original wiring.
// U15 remains HDMI diagnostics; W21 is now the control-panel S5 input.

// CA76 flute: original, user-confirmed harness and 3.3 V banks.

// E104-BT5032A-TB: module TX->D20, module RX<-C20, active-low LINK->F15.

