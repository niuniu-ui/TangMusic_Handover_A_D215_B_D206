// Dedicated slow-clock reset release: keep ALL stages in the serializer region.
// Constraining only the last stage allowed the low-fanout clock tree to span
// PTR2 and PBR3, adding 1.2 ns of clock skew in the complete design.
// Actual board pin locations; setup/recovery/removal checks remain enabled.
INS_LOC "u_tx/channels[0].serial_reset_pipe_2_s0" R103C180[0][A];
INS_LOC "u_tx/channels[1].serial_reset_pipe_2_s0" R101C180[0][A];
INS_LOC "u_tx/channels[2].serial_reset_pipe_2_s0" R59C180[0][A];
INS_LOC "u_tx/channels[0].serial_reset_pipe_0_s0" R103C180[1][A];
INS_LOC "u_tx/channels[0].serial_reset_pipe_1_s0" R103C180[0][B];
INS_LOC "u_tx/channels[1].serial_reset_pipe_0_s0" R101C180[1][A];
INS_LOC "u_tx/channels[1].serial_reset_pipe_1_s0" R101C180[0][B];
INS_LOC "u_tx/channels[2].serial_reset_pipe_0_s0" R59C180[1][A];
INS_LOC "u_tx/channels[2].serial_reset_pipe_1_s0" R59C180[0][B];
