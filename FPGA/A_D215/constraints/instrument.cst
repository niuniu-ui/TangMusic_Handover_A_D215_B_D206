// Tang Mega NEO 138K, PG484A. Direct keyboard scan; A18 pad input removed.
IO_LOC "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// Route the 50 MHz register/RAM clock on the dedicated global clock network.
// PR1014 on the unconstrained optimized build reported generic clock routing.
// Arora V SUG1018 section 2.7: use the synthesized IBUF output net name.
CLOCK_LOC "clk_d" BUFG = CLK;
IO_LOC "key_n" AB13;
IO_PORT "key_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// REV O control panel: J_IO.1=GND, .2=3V3, .13=NC (leave disconnected).
// Separate sustain board: SIG=B17 (hardware-confirmed D503), 3V3=3.3 V, GND=common ground.
IO_LOC "sustain_sig" B17;
IO_PORT "sustain_sig" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// Piano LED Native AB R04: 3*A + 2*B + T = 96 LEDs, separate from spectrum/drums.
IO_LOC "piano_guide_din" B21;
IO_PORT "piano_guide_din" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "ENC1_A" R19;
IO_LOC "ENC1_B" P19;
IO_LOC "ENC2_A" U21;
IO_LOC "ENC2_B" T21;
IO_LOC "ENC3_A" R17;
IO_LOC "ENC3_B" P16;
IO_LOC "S1_N" T18;
IO_LOC "S2_N" R18;
IO_LOC "S3_N" W17;
IO_LOC "S4_N" V17;
IO_LOC "S5_N" W21;
IO_PORT "ENC1_A" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "ENC1_B" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "ENC2_A" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "ENC2_B" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "ENC3_A" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "ENC3_B" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "S1_N" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "S2_N" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "S3_N" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "S4_N" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "S5_N" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// Direct keyboard matrix: same 16-wire harness as array_key R03.
IO_LOC "fpc_drive[0]" AA18;
IO_LOC "fpc_drive[1]" AB20;
IO_LOC "fpc_drive[2]" AA21;
