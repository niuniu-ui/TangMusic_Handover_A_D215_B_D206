etooth/core/engine/crc_index*/CE bluetooth/core/engine/drop_left*/D bluetooth/core/engine/drop_left*/CE bluetooth/core/engine/cache_req_n*/D bluetooth/core/engine/cache_req_n*/CE bluetooth/core/engine/cache_tx_n*/D bluetooth/core/engine/cache_tx_n*/CE bluetooth/core/engine/crc_work*/D bluetooth/core/engine/crc_work*/CE bluetooth/core/engine/idle_ms*/D bluetooth/core/engine/idle_ms*/CE bluetooth/core/engine/link_ms*/D bluetooth/core/engine/link_ms*/CE bluetooth/core/engine/cache_sequence*/D bluetooth/core/engine/cache_sequence*/CE bluetooth/core/engine/expected_sequence*/D bluetooth/core/engine/expected_sequence*/CE bluetooth/core/engine/cache_valid*/D bluetooth/core/engine/cache_valid*/CE bluetooth/core/engine/cache_this*/D bluetooth/core/engine/cache_this*/CE bluetooth/core/engine/hello_min*/D bluetooth/core/engine/hello_min*/CE bluetooth/core/engine/hello_max*/D bluetooth/core/engine/hello_max*/CE bluetooth/core/engine/i*/D bluetooth/core/engine/i*/CE bluetooth/core/engine/j*/D bluetooth/core/engine/j*/CE bluetooth/core/engine/index*/D bluetooth/core/engine/index*/CE bluetooth/core/engine/number*/D bluetooth/core/engine/number*/CE bluetooth/core/engine/plen*/D bluetooth/core/engine/plen*/CE bluetooth/core/engine/reply_len*/D bluetooth/core/engine/reply_len*/CE bluetooth/core/engine/command*/D bluetooth/core/engine/command*/CE bluetooth/core/engine/req_seq*/D bluetooth/core/engine/req_seq*/CE bluetooth/core/engine/status*/D bluetooth/core/engine/status*/CE bluetooth/core/engine/incoming_session*/D bluetooth/core/engine/incoming_session*/CE bluetooth/core/engine/nonce*/D bluetooth/core/engine/nonce*/CE bluetooth/core/engine/detail*/D bluetooth/core/engine/detail*/CE bluetooth/core/engine/reply_session*/D bluetooth/core/engine/reply_session*/CE bluetooth/core/engine/next_revision*/D bluetooth/core/engine/next_revision*/CE bluetooth/core/engine/changed*/D bluetooth/core/engine/changed*/CE bluetooth/core/engine/identical*/D bluetooth/core/engine/identical*/CE bluetooth/core/engine/replay*/D bluetooth/core/engine/replay*/CE bluetooth/core/engine/ordinary*/D bluetooth/core/engine/ordinary*/CE bluetooth/core/engine/defer_reply*/D bluetooth/core/engine/defer_reply*/CE bluetooth/core/engine/batch_count*/D bluetooth/core/engine/batch_count*/CE bluetooth/core/engine/batch_cursor*/D bluetooth/core/engine/batch_cursor*/CE bluetooth/core/engine/batch_seen*/D bluetooth/core/engine/batch_seen*/CE bluetooth/core/engine/value*/D bluetooth/core/engine/value*/CE bluetooth/core/engine/calculated*/D bluetooth/core/engine/calculated*/CE bluetooth/core/engine/score_request*/D bluetooth/core/engine/score_request*/CE bluetooth/core/engine/score_abort*/D bluetooth/core/engine/score_abort*/CE bluetooth/core/engine/local_ack*/D bluetooth/core/engine/local_ack*/CE bluetooth/core/engine/local_status*/D bluetooth/core/engine/local_status*/CE bluetooth/core/engine/hello_seen*/D bluetooth/core/engine/hello_seen*/CE bluetooth/core/engine/app_online*/D bluetooth/core/engine/app_online*/CE bluetooth/core/engine/session_id*/D bluetooth/core/engine/session_id*/CE bluetooth/core/engine/param_revision*/D bluetooth/core/engine/param_revision*/CE bluetooth/core/engine/state_revision*/D bluetooth/core/engine/state_revision*/CE bluetooth/core/engine/trace_parser*/D bluetooth/core/engine/trace_parser*/CE bluetooth/core/engine/trace_checksums*/D bluetooth/core/engine/trace_checksums*/CE bluetooth/core/engine/crc_errors*/D bluetooth/core/engine/crc_errors*/CE bluetooth/core/engine/param_write_count*/D bluetooth/core/engine/param_write_count*/CE bluetooth/core/engine/last_command*/D bluetooth/core/engine/last_command*/CE bluetooth/core/engine/frame_buffer*/D bluetooth/core/engine/frame_buffer*/CE bluetooth/core/engine/request_cache*/D bluetooth/core/engine/request_cache*/CE bluetooth/core/engine/response_cache*/D bluetooth/core/engine/response_cache*/CE}]
set_max_delay 20.000 -to [get_ports {drum_led_din debug_uart_tx}]
create_clock -name clk400 -period 2.5 -waveform {0 1.25} [get_nets {memory_clk}]
create_clock -name mem100 -period 10 -waveform {0 5} [get_pins {u_ddr3/gw3_top/u_ddr_phy_top/fclkdiv/CLKOUT}]
set_clock_groups -exclusive -group [get_clocks {clk400}] -group [get_clocks {clk_50m mem100}]
set_false_path -to [get_pins {bridge/req_sync_0_s0/D bridge/ack_sync_0_s0/D bridge/cal_sync_0_s0/D}]
set_false_path -to [get_pins {bridge/mem_reset_0_s0/CLEAR bridge/mem_reset_1_s0/CLEAR}]
set_max_delay -to [get_pins {bridge/mem_data_*/D}] 10
set_false_path -hold -to [get_pins {bridge/mem_data_*/D}]
set_max_delay -to [get_pins {bridge/mem_addr_*/D}] 10
set_false_path -hold -to [get_pins {bridge/mem_addr_*/D}]
set_max_delay -from [get_pins {bridge/held_write_s0/Q}] -to [get_pins {bridge/verify_write_s0/D}] 10
set_false_path -hold -from [get_pins {bridge/held_write_s0/Q}] -to [get_pins {bridge/verify_write_s0/D}]
set_max_delay -to [get_pins {bridge/read_data_*/D}] 10
set_false_path -hold -to [get_pins {bridge/read_data_*/D}]
set_max_delay -from [get_pins {bridge/ack_error_s0/Q}] -to [get_pins {bridge/error_s0/D}] 10
set_false_path -hold -from [get_pins {bridge/ack_error_s0/Q}] -to [get_pins {bridge/error_s0/D}]
set_false_path -from [get_pins {u_ddr3/gw3_top/u_ddr_phy_top/ddr_rsti_reg_*_s0/Q}] -to [get_clocks {mem100}]
set_false_path -to [get_pins {u_ddr3/gw3_top/u_ddr_phy_top/ddr_sync/recalib_s_0_s0/D u_ddr3/gw3_top/u_ddr_phy_top/wloadn_3_s0/D}]
report_timing -setup -from_clock [get_clocks {mem100}] -to_clock [get_clocks {mem100}] -max_paths 15
set_false_path -to [get_pins {loop_bridge/req_sync_0_s0/D loop_bridge/ack_sync_0_s0/D loop_bridge/cal_sync_0_s0/D}]
set_false_path -to [get_pins {loop_bridge/mem_reset_0_s0/CLEAR loop_bridge/mem_reset_1_s0/CLEAR}]
set_max_delay -to [get_pins {loop_bridge/mem_data_*/D}] 10
set_false_path -hold -to [get_pins {loop_bridge/mem_data_*/D}]
set_max_delay -to [get_pins {loop_bridge/mem_addr_*/D}] 10
set_false_path -hold -to [get_pins {loop_bridge/mem_addr_*/D}]
set_max_delay -from [get_pins {loop_bridge/held_write_s0/Q}] -to [get_pins {loop_bridge/verify_write_s0/D}] 10
set_false_path -hold -from [get_pins {loop_bridge/held_write_s0/Q}] -to [get_pins {loop_bridge/verify_write_s0/D}]
set_max_delay -to [get_pins {loop_bridge/read_data_*/D}] 10
set_false_path -hold -to [get_pins {loop_bridge/read_data_*/D}]
set_max_delay -from [get_pins {loop_bridge/ack_error_s0/Q}] -to [get_pins {loop_bridge/error_s0/D}] 10
set_false_path -hold -from [get_pins {loop_bridge/ack_error_s0/Q}] -to [get_pins {loop_bridge/error_s0/D}]

# Independent PHY RX clock and the locally generated TX clock.
create_clock -name rx125 -period 8.000 [get_ports {rx_clk}]
# The PLL regenerates its 125 MHz waveform. Time that clock from its output;
# every 50 MHz crossing uses owned dual-clock RAM or a toggle synchronizer.
# In particular, upstream 50 MHz input routing latency is not output duty jitter.
create_clock -name tx125 -period 8.000 -waveform {0.000 4.000} [get_pins {net/pll/PLL_inst/CLKOUT0}]
set_clock_uncertainty -setup 0.200 -to [get_clocks {tx125}]
set_clock_uncertainty -hold 0.050 -to [get_clocks {tx125}]
# Output-only divided PHY reference is timed as a clk data path.
set_max_delay 20.000 -to [get_ports {phy_clk}]
set_false_path -to [get_pins {net/host_reset*_s0/CLEAR net/tx_reset*_s0/CLEAR net/rx_reset*_s0/CLEAR}]
set_false_path -to [get_pins {net/enabled_tx_0_s0/D net/frames/tx_req_sync_0_s0/D net/frames/tx_ack_sync_0_s0/D net/frames/rx_req_sync_0_s0/D net/frames/rx_ack_sync_0_s0/D}]
# TX payload crosses through a dual-clock RAM. The source writes the full
# packet before request; it cannot overwrite until the frame is acknowledged.
# Bank ownership is immutable until the host has drained and acknowledged it.
set_max_delay 19.000 -from [get_pins {net/frames/published_bank*/Q}] -to [get_pins {net/frames/read_address*/D}]
set_false_path -hold -from [get_pins {net/frames/published_bank*/Q}] -to [get_pins {net/frames/read_address*/D}]

# Only the first stage of the independent flute probe is asynchronous.
set_false_path -from [get_ports {flute_keys_n[*]}] -to [get_pins {flute_latency/keys_meta*_s0/D}]
set_max_delay 20.000 -to [get_ports {piano_scan_probe flute_key_probe drum_hit_probe}]
